# EXEMPLO — não coloque valores reais neste arquivo nem o commite com valores.
# Copie para .env (que está no .gitignore) só se for usar scripts locais.

# URL do projeto Supabase (Project Settings > API). Público.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública: "anon" (eyJ...) ou "publishable" (sb_publishable_...). O site é estático (sem build), então esta chave vai
# para js/config.js > supabase.anonKey — não é lida de variável de ambiente.
SUPABASE_ANON_KEY=cole-aqui-a-chave-anon

# Chave "service_role": acesso TOTAL ao banco. NUNCA no site, nunca no Git.
# Só use em scripts locais pontuais (ex.: migração em massa), se precisar.
# SUPABASE_SERVICE_ROLE_KEY=
